# Database Credentials (Used by Docker Compose)
DB_USER=admin
DB_PASSWORD=password
DB_NAME=zerodha
# Auth Secrets (Used by your controllers/middleware)
TOKEN_KEY=my_super_secret_jwt_token_12345

# Port for the app to run on inside the container
PORT=3002

# Note: The MONGO_URI is handled by the docker-compose.yml 
# so don't need to hardcode
MONGODB_URI=mongodb://admin:password@mongo:27017/